<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Test classes run in parallel; each test method gets its own browser. -->
<suite name="Toolshop UI" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="io.github.mofrhhue.toolshop.core.ScreenshotOnFailure"/>
    </listeners>
    <test name="UI tests">
        <packages>
            <package name="io.github.mofrhhue.toolshop.tests"/>
        </packages>
    </test>
</suite>
